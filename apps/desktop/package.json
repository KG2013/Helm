{
  "name": "@helm/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Helm desktop workbench shell",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && HELM_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "start": "electron .",
    "preview": "vite preview --config vite.config.ts",
    "build:electron": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "test": "tsx --test test/*.test.ts",
    "test:electron": "tsx test/electron-smoke.ts"
  },
  "dependencies": {
    "@helm/runtime": "workspace:*",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.5.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "wait-on": "9.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
