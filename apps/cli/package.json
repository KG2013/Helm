{
  "name": "@helm/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Helm local harness command-line interface",
  "type": "module",
  "bin": {
    "helm": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "predev": "pnpm --filter @helm/runtime build",
    "prebuild": "pnpm --filter @helm/runtime build",
    "pretypecheck": "pnpm --filter @helm/runtime build"
  },
  "dependencies": {
    "@helm/providers": "workspace:*",
    "@helm/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
