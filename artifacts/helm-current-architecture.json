  "cards": [
    {
      "dot": "cyan",
      "title": "当前主路径",
      "items": [
        "桌面 Renderer → typed preload/IPC → Electron Main → Runtime；CLI 直接进入同一 Runtime。",
        "Runtime 调用默认 Mock Provider，也可通过 Keychain-backed Kimi Code 发起真实文本请求。"
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime 控制与证据",
      "items": [
        "Task/Session/Run、审批、事件回放、ToolPolicy 默认拒绝和 needs_reconciliation 分支已实现并测试。",
        "Verifier 当前只检查最终文本非空；Event Ledger 仍是进程内存储。"
      ]
    },
    {
      "dot": "amber",
      "title": "待接入边界",
